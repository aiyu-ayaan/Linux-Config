[delta]
    navigate = true
    navigate-regex = "^(commit|---|\\+\\+\\+|@@|diff)"
    line-numbers = true
    line-numbers-minus-style = "#f38ba8"
    line-numbers-plus-style = "#a6e3a1"
    line-numbers-zero-style = "#6c7086"
    line-numbers-left-format = "{nm:^4}│"
    line-numbers-right-format = "{np:^4}│"
    minus-style = "syntax #f38ba8"
    minus-non-emph-style = "syntax #f38ba8"
    minus-emph-style = "syntax #11111b #f38ba8"
    plus-style = "syntax #a6e3a1"
    plus-non-emph-style = "syntax #a6e3a1"
    plus-emph-style = "syntax #11111b #a6e3a1"
    zero-style = "syntax #6c7086"
    whitespace-error-style = "#11111b #f38ba8"
    blame-code-style = "syntax #6c7086"
    blame-format = "{author:<18} {commit:<8} {timestamp:<12} "
    file-style = "#cba6f7 bold"
    file-decoration-style = "#cba6f7 ul"
    hunk-header-style = "#89b4fa bold"
    hunk-header-decoration-style = "#89b4fa box"
    commit-style = "#f9e2af bold"
    commit-decoration-style = ""
    syntax-theme = "Catppuccin Mocha"
    true-color = "always"
    tabs = 4
    side-by-side = false
